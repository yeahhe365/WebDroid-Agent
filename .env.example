# Copy this file to .env and adjust as needed.
# Only the OpenAI proxy URL is read from the Vite-injected env at build/runtime;
# server-side host/port are read by dist-server/index.js when running the Node server.

# Frontend: same-origin proxy envelope used by the Node server.
# In Docker this is set to /api/openai/chat/completions at build time (see Dockerfile).
# Official OpenAI uses the Responses API via the same envelope with path=/responses.
# Other OpenAI-compatible providers (and Qwen) use /chat/completions through this proxy.
# The Gemini provider preset connects directly to Google's REST API and skips this proxy.
VITE_OPENAI_PROXY_URL=/api/openai/chat/completions

# Node server (npm run build:server && npm start, or Docker) — host/port only.
# The server defaults to 127.0.0.1 (loopback). Set HOST=0.0.0.0 to listen on all
# interfaces; the Docker image already sets HOST=0.0.0.0 for port mapping.
PORT=8080
HOST=127.0.0.1

# Optional server-side proxy hardening (unset = trusted local development):
# PROXY_TOKEN=***        # require this shared secret on proxy requests
#                          # (send as `x-proxy-token: <token>` or `Authorization: Bearer <token>`)
# PROXY_ALLOW_HOSTS=api.openai.com,dashscope.aliyuncs.com
#                          # restrict which upstream hosts the proxy forwards to
#                          # (exact host, host:port, or wildcard *.example.com; empty = no restriction)
# CSP_CONNECT_SRC=https://api.moonshot.cn
#                          # extra space-separated origins appended to the frontend CSP connect-src
